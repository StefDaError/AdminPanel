<Window x:Class="AdminPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AdminPanel"
        Title="Админ-панель"
        Width="1150" Height="750"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#E8E8E8">

    <Window.Resources>
        <!-- Конвертеры для переключения видимости панелей -->
        <local:NullToVisibilityConverter x:Key="NullToVis"/>
        <local:NotNullToVisibilityConverter x:Key="NotNullToVis"/>

        <!-- Группировка комплектующих по категориям -->
        <CollectionViewSource x:Key="ComponentsView" Source="{Binding SelectedAgentComponents}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Базовые стили -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4FC1FF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Стили для кнопок -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3F3F46"/>
                    <Setter Property="Foreground" Value="#9A9A9A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стили для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="CaretBrush" Value="#E8E8E8"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стили для списка -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0E639C"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D2D30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Основная сетка -->
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Управление сервером" Style="{StaticResource Header}"/>

                <!-- Кнопки управления -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Запустить" Command="{Binding StartCommand}" Margin="0,0,8,0" Width="100"/>
                    <Button Content="Остановить" Command="{Binding StopCommand}" Width="100"/>
                </StackPanel>

                <!-- Кнопка очистки БД -->
                <Button Content="Очистить БД" 
                        Command="{Binding ClearDbCommand}" 
                        Background="#C42B1C" 
                        Margin="0,0,0,8" 
                        HorizontalAlignment="Left" 
                        Width="208"/>

                <!-- Кнопка экспорта -->
                <Button Content="Экспорт в Excel"
                        Command="{Binding ExportExcelCommand}"
                        Background="#1D7044"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        Width="208"/>

                <TextBlock Text="{Binding Status}" Foreground="#9A9A9A" Margin="0,0,0,4" TextWrapping="Wrap"/>

                <!-- Блок ссылки для агента -->
                <TextBlock Text="Ссылка для агента:" Foreground="#4FC1FF" FontSize="12" Margin="0,12,0,4"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding AgentUrl, Mode=OneWay}"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Копировать"
                            Command="{Binding CopyUrlCommand}"
                            Margin="8,0,0,0"
                            Padding="10,0"/>
                </Grid>
            </StackPanel>

            <!-- Список подключенных агентов -->
            <TextBlock DockPanel.Dock="Top" Text="Подключенные агенты" Style="{StaticResource Header}"/>
            <ListBox ItemsSource="{Binding Agents}"
                     SelectedItem="{Binding SelectedAgent}"
                     VerticalContentAlignment="Top">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding DomainName}"
                                       FontWeight="Bold" FontSize="13" Foreground="#E8E8E8"/>
                            <TextBlock Text="{Binding IpAddress}"
                                       FontSize="11" Foreground="#9A9A9A" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding OsVersion}"
                                       FontSize="11" Foreground="#9A9A9A"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding LastSeen, StringFormat='Был в сети: {0:HH:mm:ss}'}"
                                       FontSize="11" Foreground="#6F6F6F" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ПРАВАЯ ПАНЕЛЬ (Детали выбранного агента) -->
        <Border Grid.Column="2" Background="#252526" CornerRadius="8" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Заглушка, если агент не выбран -->
                    <TextBlock Text="Выберите агента из списка слева"
                               Foreground="#6F6F6F"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding SelectedAgent, Converter={StaticResource NullToVis}}"/>

                    <!-- Данные выбранного агента -->
                    <StackPanel Visibility="{Binding SelectedAgent, Converter={StaticResource NotNullToVis}}">

                        <!-- Шапка агента -->
                        <TextBlock Text="{Binding SelectedAgent.DomainName}"
                                   FontSize="24" FontWeight="Bold" Foreground="#4FC1FF"/>
                        <TextBlock Text="{Binding SelectedAgent.OsVersion}"
                                   Foreground="#9A9A9A" Margin="0,4,0,24" FontSize="14"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="IP-адрес" Style="{StaticResource Header}"/>
                                <TextBlock Text="{Binding SelectedAgent.IpAddress}" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Платформа" Style="{StaticResource Header}"/>
                                <TextBlock Text="{Binding SelectedAgent.Platform}" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Последнее подключение" Style="{StaticResource Header}"/>
                                <TextBlock Text="{Binding SelectedAgent.LastSeen, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Снимков в базе" Style="{StaticResource Header}"/>
                                <TextBlock Text="{Binding SelectedAgent.SnapshotCount}" FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#3F3F46" Margin="0,0,0,16"/>

                        <!-- Блок комплектующих -->
                        <TextBlock Text="Комплектующие ПК" Style="{StaticResource Header}" FontSize="16" Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding Source={StaticResource ComponentsView}}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" 
                                                       Foreground="#4FC1FF" 
                                                       FontWeight="Bold" 
                                                       FontSize="13" 
                                                       Margin="0,12,0,6"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E1E" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" 
                                                       Foreground="#E8E8E8" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" 
                                                       Margin="0,0,16,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Specs}" 
                                                       Foreground="#9A9A9A" 
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>